# Production Web & AI Backend Configuration

# Backend API URL (used by Next.js frontend to dispatch inference jobs)
# Local: http://127.0.0.1:8001
# Production: https://your-backend-service.onrender.com or cloud container URL
NEXT_PUBLIC_AI_BACKEND_URL=http://127.0.0.1:8001

# Vercel Blob Object Storage Token (optional, for client-side direct uploads)
# Generated in Vercel Project Settings > Storage > Blob
BLOB_READ_WRITE_TOKEN=

# S3-compatible Object Storage Bucket (alternative to Vercel Blob)
STORAGE_BUCKET=

# Backend CORS Allowed Origins (comma-separated domains)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://smart-airport-luggage.vercel.app

# Max Allowed Video Upload Size in Megabytes
MAX_UPLOAD_MB=100

# Backend Execution Port (default: 8001 locally, $PORT in container)
PORT=8001
